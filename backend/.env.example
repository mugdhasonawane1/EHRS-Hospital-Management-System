# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Local MongoDB, or swap in an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hospital_management

# ---- Auth ----
# Use long random strings in anything that isn't your laptop.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Business rules ----
# Default length of an appointment when the doctor's slot config doesn't say otherwise
DEFAULT_APPOINTMENT_MINUTES=30
# How long before the appointment a patient may still cancel
CANCELLATION_WINDOW_HOURS=2
# Invoice defaults
INVOICE_TAX_RATE=0.05
INVOICE_DUE_DAYS=14

# ---- Seed script ----
# Password given to every demo account created by `npm run seed`
SEED_PASSWORD=Password123!
